<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.calcfx.HelloController"
      styleClass="root-hbox" spacing="12">

    <VBox fx:id="calculatorColumn" styleClass="root-vbox" spacing="4" prefWidth="400" HBox.hgrow="NEVER">
        <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label fx:id="statusLabel" text="DEG" styleClass="status-label"
                   maxWidth="Infinity" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS"/>
            <Button fx:id="calculusToggle" text="∂" onAction="#onToggleCalculus" styleClass="toggle-btn"/>
            <Button fx:id="graphToggle" text="📈" onAction="#onToggleGraph" styleClass="toggle-btn"/>
            <Button fx:id="historyToggle" text="🕘" onAction="#onToggleHistory" styleClass="toggle-btn"/>
            <Button fx:id="currencyToggle" text="💱" onAction="#onToggleCurrency" styleClass="toggle-btn"/>
            <Button fx:id="matrixToggle" text="▦" onAction="#onToggleMatrix" styleClass="toggle-btn"/>
            <Button fx:id="complexToggle" text="ℂ" onAction="#onToggleComplex" styleClass="toggle-btn"/>
        </HBox>

        <Label fx:id="expressionLabel" text="" styleClass="expression-label"
               maxWidth="Infinity" alignment="CENTER_RIGHT"/>
        <Label fx:id="resultLabel" text="0" styleClass="result-label"
               maxWidth="Infinity" alignment="CENTER_RIGHT"/>

        <GridPane fx:id="calculatorGrid" hgap="6" vgap="6">
            <columnConstraints>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="48"/><RowConstraints minHeight="48"/>
                <RowConstraints minHeight="48"/><RowConstraints minHeight="48"/>
                <RowConstraints minHeight="48"/><RowConstraints minHeight="48"/>
                <RowConstraints minHeight="48"/><RowConstraints minHeight="48"/>
                <RowConstraints minHeight="48"/>
            </rowConstraints>

            <!-- Row 0: ( ) % ⌫ -->
            <Button text="(" onAction="#onOpenParen"  styleClass="paren-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Button text=")" onAction="#onCloseParen" styleClass="paren-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Button text="\%" onAction="#onPercent"   styleClass="op-btn"    maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <Button text="⌫" onAction="#onBackspace"  styleClass="clear-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <!-- Row 1: sin cos tan log -->
            <Button text="sin" onAction="#onSin" styleClass="sci-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <Button text="cos" onAction="#onCos" styleClass="sci-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Button text="tan" onAction="#onTan" styleClass="sci-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <Button text="log" onAction="#onLog" styleClass="sci-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <!-- Row 2: ln √ x² xʸ -->
            <Button text="ln" onAction="#onLn"     styleClass="sci-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <Button text="√"  onAction="#onSqrt"   styleClass="sci-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <Button text="x²" onAction="#onSquare" styleClass="sci-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
            <Button text="xʸ" onAction="#onPower"  styleClass="sci-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

            <!-- Row 3: MC MR M+ M- -->
            <Button text="MC" onAction="#onMemoryClear"    styleClass="mem-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <Button text="MR" onAction="#onMemoryRecall"   styleClass="mem-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            <Button text="M+" onAction="#onMemoryAdd"      styleClass="mem-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
            <Button text="M-" onAction="#onMemorySubtract" styleClass="mem-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="3"/>

            <!-- Row 4: Deg π e C -->
            <Button fx:id="angleModeButton" text="Deg" onAction="#onToggleAngleMode" styleClass="toggle-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <Button text="π" onAction="#onPi"    styleClass="sci-btn"   maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
            <Button text="e" onAction="#onE"     styleClass="sci-btn"   maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
            <Button text="C" onAction="#onClear" styleClass="clear-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="4"/>

            <!-- Row 5: 7 8 9 ÷ -->
            <Button text="7" onAction="#onNumber"   styleClass="num-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <Button text="8" onAction="#onNumber"   styleClass="num-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
            <Button text="9" onAction="#onNumber"   styleClass="num-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="5"/>
            <Button text="÷" onAction="#onOperator" styleClass="op-btn"  maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="5"/>

            <!-- Row 6: 4 5 6 × -->
            <Button text="4" onAction="#onNumber"   styleClass="num-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
            <Button text="5" onAction="#onNumber"   styleClass="num-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
            <Button text="6" onAction="#onNumber"   styleClass="num-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="6"/>
            <Button text="×" onAction="#onOperator" styleClass="op-btn"  maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="6"/>

            <!-- Row 7: 1 2 3 − -->
            <Button text="1" onAction="#onNumber"   styleClass="num-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
            <Button text="2" onAction="#onNumber"   styleClass="num-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
            <Button text="3" onAction="#onNumber"   styleClass="num-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="7"/>
            <Button text="−" onAction="#onOperator" styleClass="op-btn"  maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="7"/>

            <!-- Row 8: 0 . = + -->
            <Button text="0" onAction="#onNumber"   styleClass="num-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
            <Button text="." onAction="#onDot"      styleClass="num-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
            <Button text="=" onAction="#onEquals"   styleClass="eq-btn"  maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="8"/>
            <Button text="+" onAction="#onOperator" styleClass="op-btn"  maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="8"/>
        </GridPane>

        <!-- Currency converter panel (hidden until 💱 is pressed) -->
        <VBox fx:id="currencyPane" spacing="14" visible="false" managed="false" styleClass="currency-pane">
            <Label text="Currency Converter" styleClass="currency-title" maxWidth="Infinity" alignment="CENTER"/>
            <TextField fx:id="amountField" promptText="Amount" styleClass="amount-field"/>
            <HBox spacing="8" alignment="CENTER">
                <ComboBox fx:id="fromCurrency" promptText="From" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button text="⇄" onAction="#onSwapCurrencies" styleClass="paren-btn"/>
                <ComboBox fx:id="toCurrency" promptText="To" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
            <Button text="Convert" onAction="#onConvert" styleClass="eq-btn convert-btn" maxWidth="Infinity"/>
            <Label fx:id="conversionResultLabel" text="" styleClass="conversion-result" maxWidth="Infinity" alignment="CENTER"/>
            <Label fx:id="rateInfoLabel" text="" styleClass="rate-info" maxWidth="Infinity" alignment="CENTER"/>
        </VBox>

        <!-- History panel (hidden until 🕘 is pressed) -->
        <VBox fx:id="historyPane" spacing="10" visible="false" managed="false" styleClass="history-pane" VBox.vgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="History" styleClass="currency-title" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button text="Edit" onAction="#onEditHistoryEntry" styleClass="edit-history-btn"/>
                <Button text="Clear" onAction="#onClearHistory" styleClass="clear-history-btn"/>
            </HBox>
            <ListView fx:id="historyListView" styleClass="history-list" VBox.vgrow="ALWAYS"/>
        </VBox>

        <!-- Calculus panel (hidden until ∂ is pressed) -->
        <VBox fx:id="calculusPane" spacing="14" visible="false" managed="false" styleClass="currency-pane">
            <Label text="Calculus" styleClass="currency-title" maxWidth="Infinity" alignment="CENTER"/>
            <TextField fx:id="calcFunctionField" promptText="f(x), e.g. sin(x) or x^2" styleClass="amount-field"/>

            <HBox spacing="8" alignment="CENTER">
                <Button fx:id="derivativeModeButton" text="Derivative" onAction="#onSelectDerivativeMode" styleClass="mode-btn mode-btn-active" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button fx:id="integralModeButton" text="Integral" onAction="#onSelectIntegralMode" styleClass="mode-btn" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>

            <VBox fx:id="derivativeInputs" spacing="8">
                <TextField fx:id="pointField" promptText="x = (point to evaluate at)" styleClass="amount-field"/>
            </VBox>

            <VBox fx:id="integralInputs" spacing="8" visible="false" managed="false">
                <HBox spacing="8">
                    <TextField fx:id="lowerBoundField" promptText="a = (lower bound)" styleClass="amount-field" HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="upperBoundField" promptText="b = (upper bound)" styleClass="amount-field" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <Button text="Calculate" onAction="#onCalculateCalculus" styleClass="eq-btn convert-btn" maxWidth="Infinity"/>
            <Label fx:id="calcResultLabel" text="" styleClass="conversion-result" maxWidth="Infinity" alignment="CENTER" wrapText="true"/>
        </VBox>

        <!-- Matrix panel (hidden until ▦ is pressed) -->
        <VBox fx:id="matrixPane" spacing="8" visible="false" managed="false" styleClass="currency-pane">
            <Label text="Matrix Operations" styleClass="currency-title" maxWidth="Infinity" alignment="CENTER"/>

            <HBox spacing="12" alignment="TOP_CENTER">
                <VBox spacing="6" alignment="TOP_CENTER" HBox.hgrow="ALWAYS">
                    <Label text="Matrix A" styleClass="matrix-label"/>
                    <HBox spacing="4" alignment="CENTER">
                        <ComboBox fx:id="rowsA" prefWidth="64"/>
                        <Label text="×" styleClass="matrix-label"/>
                        <ComboBox fx:id="colsA" prefWidth="64"/>
                    </HBox>
                    <GridPane fx:id="gridA" hgap="3" vgap="3" alignment="CENTER"/>
                </VBox>

                <VBox spacing="6" alignment="TOP_CENTER" HBox.hgrow="ALWAYS">
                    <Label text="Matrix B" styleClass="matrix-label"/>
                    <HBox spacing="4" alignment="CENTER">
                        <ComboBox fx:id="rowsB" prefWidth="64"/>
                        <Label text="×" styleClass="matrix-label"/>
                        <ComboBox fx:id="colsB" prefWidth="64"/>
                    </HBox>
                    <GridPane fx:id="gridB" hgap="3" vgap="3" alignment="CENTER"/>
                </VBox>
            </HBox>

            <TextField fx:id="scalarField" promptText="scalar k (used by k·A)" styleClass="amount-field"/>

            <GridPane hgap="6" vgap="6">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                </columnConstraints>

                <Button text="A+B" userData="add"       onAction="#onMatrixOp" styleClass="sci-btn" maxWidth="Infinity" prefHeight="34" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Button text="A−B" userData="sub"       onAction="#onMatrixOp" styleClass="sci-btn" maxWidth="Infinity" prefHeight="34" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Button text="A×B" userData="mul"       onAction="#onMatrixOp" styleClass="sci-btn" maxWidth="Infinity" prefHeight="34" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <Button text="k·A" userData="scale"     onAction="#onMatrixOp" styleClass="sci-btn" maxWidth="Infinity" prefHeight="34" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                <Button text="Aᵀ"    userData="transpose" onAction="#onMatrixOp" styleClass="sci-btn" maxWidth="Infinity" prefHeight="34" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Button text="det A" userData="det"       onAction="#onMatrixOp" styleClass="sci-btn" maxWidth="Infinity" prefHeight="34" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Button text="A⁻¹"   userData="inv"       onAction="#onMatrixOp" styleClass="sci-btn" maxWidth="Infinity" prefHeight="34" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <Button text="tr A"  userData="trace"     onAction="#onMatrixOp" styleClass="sci-btn" maxWidth="Infinity" prefHeight="34" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                <Button text="RREF"  userData="rref"  onAction="#onMatrixOp" styleClass="sci-btn"   maxWidth="Infinity" prefHeight="34" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <Button text="rank"  userData="rank"  onAction="#onMatrixOp" styleClass="sci-btn"   maxWidth="Infinity" prefHeight="34" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Button text="Ax=b"  userData="solve" onAction="#onMatrixOp" styleClass="sci-btn"   maxWidth="Infinity" prefHeight="34" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                <Button text="Clear" userData="clear" onAction="#onMatrixOp" styleClass="clear-btn" maxWidth="Infinity" prefHeight="34" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
            </GridPane>

            <Label text="Ax = b uses the first column of B as b" styleClass="rate-info" maxWidth="Infinity" alignment="CENTER"/>
            <Label fx:id="matrixResultLabel" text="" styleClass="matrix-result" maxWidth="Infinity" alignment="CENTER"/>
        </VBox>

        <!-- Complex number panel (hidden until ℂ is pressed) -->
        <VBox fx:id="complexPane" spacing="10" visible="false" managed="false" styleClass="currency-pane">
            <Label text="Complex Numbers" styleClass="currency-title" maxWidth="Infinity" alignment="CENTER"/>

            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="z₁ =" styleClass="matrix-label" minWidth="34"/>
                <TextField fx:id="z1Re" promptText="real" styleClass="amount-field" minWidth="0" prefWidth="80" HBox.hgrow="ALWAYS"/>
                <Label text="+" styleClass="matrix-label"/>
                <TextField fx:id="z1Im" promptText="imag" styleClass="amount-field" minWidth="0" prefWidth="80" HBox.hgrow="ALWAYS"/>
                <Label text="i" styleClass="matrix-label"/>
            </HBox>

            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="z₂ =" styleClass="matrix-label" minWidth="34"/>
                <TextField fx:id="z2Re" promptText="real" styleClass="amount-field" minWidth="0" prefWidth="80" HBox.hgrow="ALWAYS"/>
                <Label text="+" styleClass="matrix-label"/>
                <TextField fx:id="z2Im" promptText="imag" styleClass="amount-field" minWidth="0" prefWidth="80" HBox.hgrow="ALWAYS"/>
                <Label text="i" styleClass="matrix-label"/>
            </HBox>

            <TextField fx:id="complexNField" promptText="n (whole number, for zⁿ and ⁿ√z)" styleClass="amount-field"/>

            <GridPane hgap="6" vgap="6">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                </columnConstraints>

                <Button text="z₁+z₂" userData="add" onAction="#onComplexOp" styleClass="sci-btn" maxWidth="Infinity" prefHeight="34" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Button text="z₁−z₂" userData="sub" onAction="#onComplexOp" styleClass="sci-btn" maxWidth="Infinity" prefHeight="34" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Button text="z₁×z₂" userData="mul" onAction="#onComplexOp" styleClass="sci-btn" maxWidth="Infinity" prefHeight="34" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <Button text="z₁÷z₂" userData="div" onAction="#onComplexOp" styleClass="sci-btn" maxWidth="Infinity" prefHeight="34" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                <Button text="conj"  userData="conj"  onAction="#onComplexOp" styleClass="sci-btn" maxWidth="Infinity" prefHeight="34" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Button text="|z|"   userData="mod"   onAction="#onComplexOp" styleClass="sci-btn" maxWidth="Infinity" prefHeight="34" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Button text="polar" userData="polar" onAction="#onComplexOp" styleClass="sci-btn" maxWidth="Infinity" prefHeight="34" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <Button text="1/z"   userData="recip" onAction="#onComplexOp" styleClass="sci-btn" maxWidth="Infinity" prefHeight="34" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                <Button text="√z"   userData="sqrt"  onAction="#onComplexOp" styleClass="sci-btn"   maxWidth="Infinity" prefHeight="34" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <Button text="zⁿ"   userData="pow"   onAction="#onComplexOp" styleClass="sci-btn"   maxWidth="Infinity" prefHeight="34" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Button text="ⁿ√z"  userData="roots" onAction="#onComplexOp" styleClass="sci-btn"   maxWidth="Infinity" prefHeight="34" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                <Button text="Clear" userData="clear" onAction="#onComplexOp" styleClass="clear-btn" maxWidth="Infinity" prefHeight="34" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
            </GridPane>

            <Label text="Unary operations (conj, |z|, polar, 1/z, √z, zⁿ, ⁿ√z) use z₁ only" styleClass="rate-info" maxWidth="Infinity" alignment="CENTER" wrapText="true"/>
            <Label fx:id="complexResultLabel" text="" styleClass="matrix-result" maxWidth="Infinity" alignment="CENTER" wrapText="true"/>
        </VBox>
    </VBox>

    <!-- Graph panel (hidden until 📈 is pressed) — appears beside the calculator -->
    <VBox fx:id="graphPane" spacing="10" visible="false" managed="false" styleClass="graph-pane" minWidth="380" HBox.hgrow="ALWAYS">
        <padding><Insets top="12" right="12" bottom="12" left="0"/></padding>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Graphing" styleClass="currency-title" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button text="Reset View" onAction="#onResetGraphView" styleClass="clear-history-btn"/>
        </HBox>

        <ScrollPane fitToWidth="true" prefHeight="140" styleClass="function-scroll">
            <VBox fx:id="functionListBox" spacing="6"/>
        </ScrollPane>
        <Button fx:id="addFunctionButton" text="+ Add Function" onAction="#onAddFunction" styleClass="add-function-btn" maxWidth="Infinity"/>

        <Pane fx:id="graphCanvasContainer" styleClass="graph-canvas-container" VBox.vgrow="ALWAYS">
            <Canvas fx:id="graphCanvas"/>
        </Pane>
    </VBox>
</HBox>